# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://election_user:CHANGE_ME@localhost:5432/election_db"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRATION="8h"

# ─── Cookie ──────────────────────────────────────────────────────────────────
# Optional secret for signed cookies (leave empty in dev to use unsigned cookies)
COOKIE_SECRET=""

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS="http://localhost:3000"
